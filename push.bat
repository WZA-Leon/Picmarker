@echo off
chcp 65001 >nul
title Git 快速提交工具

:: ============================================
:: 预设身份（你的 GitHub 信息）
:: ============================================
set PRESET_NAME=WZA-Leon
set PRESET_EMAIL=wza-dl@outlook.com

echo ==============================================
echo  当前仓库路径：%cd%
echo ==============================================

:: -------------------------------------------------
:: 1. 检查并配置 Git 用户身份
:: -------------------------------------------------
echo.
echo [1/4] 检查 Git 用户身份配置...

:: 检查是否已配置全局 user.name
git config --global user.name >nul 2>nul
if errorlevel 1 (
    echo [!] 本机未配置 Git 全局用户名/邮箱。
    echo     将使用预设身份（%PRESET_NAME%）配置【当前仓库】。
    git config user.name "%PRESET_NAME%"
    git config user.email "%PRESET_EMAIL%"
    echo [√] 当前仓库身份已设置为：%PRESET_NAME%
) else (
    for /f "delims=" %%i in ('git config --global user.name') do set global_name=%%i
    echo [√] 检测到全局身份：%global_name%，将直接用于本次提交。
)

:: -------------------------------------------------
:: 2. 显示当前更改状态
:: -------------------------------------------------
echo.
echo [2/4] 当前更改状态：
echo ----------------------------------------------
git status
echo ----------------------------------------------

:: -------------------------------------------------
:: 3. 输入提交信息（直接回车使用"日常更新"）
:: -------------------------------------------------
echo.
set /p msg="请输入本次提交说明（直接回车使用默认信息）: "
if "%msg%"=="" set msg="日常更新"

:: -------------------------------------------------
:: 4. 执行 Add、Commit、Push
:: -------------------------------------------------
echo.
echo [3/4] 正在暂存更改（git add .）...
git add .
if errorlevel 1 (
    echo [错误] git add 失败，请确认是否在 Git 仓库目录下。
    pause
    exit /b
)

echo.
echo [4/4] 正在提交并推送...
git commit -m "%msg%"
if errorlevel 1 (
    echo [错误] 提交失败（可能没有实质更改，或身份配置有问题）。
    pause
    exit /b
)

git push
if errorlevel 1 (
    echo [错误] 推送失败，请检查网络或远程仓库权限。
    pause
    exit /b
)

:: -------------------------------------------------
:: 5. 完成
:: -------------------------------------------------
echo.
echo ==============================================
echo ✅ 全部完成！代码已同步至 GitHub。
echo ==============================================
pause >nul